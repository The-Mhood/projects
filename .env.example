# Public Supabase project URL and publishable key may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only elevated key. Never prefix with NEXT_PUBLIC_ and never commit its value.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Explicit guard: this app only supports its local integration POC, not production checkout.
MARCADELE_POC_ONLY=true

# Stripe test-mode secret and webhook signing secret for the POC.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public base URL for checkout return routes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
